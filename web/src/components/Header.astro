---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { LINKS } from "../site";
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Roomy home">
      <Logo height={24} label="Roomy" />
    </a>
    <nav aria-label="Primary">
      <ul class="links">
        <li><a href="#views">Features</a></li>
        <li><a href="#safety">Safety</a></li>
        <li><a href="#download">Download</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </nav>
    <div class="actions">
      <a class="icon-btn" href={LINKS.github} aria-label="Roomy on GitHub">
        <Icon name="github" size={18} />
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
        <Icon name="moon" size={18} class="i-moon" />
        <Icon name="sun" size={18} class="i-sun" />
      </button>
      <a class="btn btn-primary btn-sm get" href="#download">Download</a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const sync = () => {
    const dark = root.dataset.theme === "dark";
    btn?.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
    meta?.setAttribute("content", dark ? "#131210" : "#F4F2EC");
  };
  sync();
  btn?.addEventListener("click", () => {
    root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
    try {
      localStorage.setItem("roomy-theme", root.dataset.theme);
    } catch {
      /* storage unavailable: the theme still applies for this visit */
    }
    sync();
  });

  const header = document.querySelector(".header");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 4);
  requestAnimationFrame(onScroll);
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-base) var(--ease);
  }
  .header:global(.scrolled) {
    border-bottom-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    color: var(--ink);
    border-radius: 6px;
  }
  nav {
    margin-left: auto;
  }
  .links {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease);
  }
  .links a:hover {
    color: var(--ink);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    border: 0;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .icon-btn:hover {
    color: var(--ink);
    background: var(--sunken);
  }
  .theme-toggle :global(.i-sun) {
    display: none;
  }
  :global([data-theme="dark"]) .theme-toggle :global(.i-sun) {
    display: block;
  }
  :global([data-theme="dark"]) .theme-toggle :global(.i-moon) {
    display: none;
  }
  .get {
    margin-left: 0.5rem;
  }

  @media (max-width: 820px) {
    nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (max-width: 360px) {
    .get {
      display: none;
    }
  }
</style>
