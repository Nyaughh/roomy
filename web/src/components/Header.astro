---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { LINKS } from "../site";
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Roomy home">
      <Logo id="hdr" height={30} />
    </a>
    <nav aria-label="Primary">
      <ul class="links">
        <li><a href="#features">Features</a></li>
        <li><a href="#safety">Safety</a></li>
        <li><a href="#download">Download</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </nav>
    <div class="actions">
      <a class="icon-btn" href={LINKS.github} aria-label="Roomy on GitHub">
        <Icon name="github" size={19} />
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label="Switch to light theme" data-theme-toggle>
        <Icon name="sun" size={19} class="i-sun" />
        <Icon name="moon" size={19} class="i-moon" />
      </button>
      <a class="btn btn-primary btn-sm get" href="#download">Download</a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const sync = () => {
    const light = root.dataset.theme === "light";
    btn?.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
    meta?.setAttribute("content", light ? "#F7F7FB" : "#0B0C16");
  };
  sync();
  btn?.addEventListener("click", () => {
    root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
    try {
      localStorage.setItem("roomy-theme", root.dataset.theme);
    } catch {
      /* storage unavailable: theme still applies for this visit */
    }
    sync();
  });

  const header = document.querySelector(".header");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 8);
  // Defer the first read so it doesn't force a synchronous layout during page load.
  requestAnimationFrame(onScroll);
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      backdrop-filter 0.3s;
  }
  .header:global(.scrolled) {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom-color: var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    text-decoration: none;
    color: var(--text);
    border-radius: 10px;
  }
  nav {
    margin-left: auto;
  }
  .links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: 10px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 500;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .links a:hover {
    color: var(--text);
    background: var(--raised);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }
  .icon-btn:hover {
    color: var(--text);
    background: var(--raised);
    border-color: var(--border);
  }
  .theme-toggle :global(.i-moon) {
    display: none;
  }
  :global([data-theme="light"]) .theme-toggle :global(.i-sun) {
    display: none;
  }
  :global([data-theme="light"]) .theme-toggle :global(.i-moon) {
    display: block;
  }
  .get {
    margin-left: 0.35rem;
  }

  @media (max-width: 820px) {
    nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (max-width: 380px) {
    .get {
      display: none;
    }
  }
</style>
