---
import Icon from "./Icon.astro";
import { LINKS } from "../site";

const a = (href: string, text: string) => `<a class="prose-link" href="${href}">${text}</a>`;

const faqs = [
  {
    q: "Is Roomy really free?",
    a: `Yes. Roomy is free and open source under the ${a(LINKS.license, "MIT license")}, with no trial, no ads and no paid tier. The code is on ${a(LINKS.github, "GitHub")}.`,
  },
  {
    q: "Why does Windows or macOS warn me when I open it?",
    a: `Roomy isn't code-signed or notarized yet, and both systems are cautious about apps without a paid certificate. Follow the short ${a("#install", "install notes")} the first time; after that it opens normally.`,
  },
  {
    q: "Could Roomy delete something important?",
    a: "It's built to make that very hard. Critical system folders are blocked outright, and nothing that holds your own content is pre-selected. Suggested clean-ups end on a review screen listing each item, its size and how it will be removed, and nothing in it runs until you confirm. When you delete something yourself, a single item goes straight to the Recycle Bin or Trash, where you can restore it; several items at once, or a permanent delete, ask you to confirm first.",
  },
  {
    q: "Can I get things back after a clean-up?",
    a: "It depends on how each item was removed, and the review screen tells you before you confirm. Files and folders you delete from a view, and duplicates you clean up, go to the Recycle Bin or Trash by default, so you can restore them from there. Suggested caches, temporary files and project build folders are deleted permanently, because binning them would free no space; caches rebuild on their own, and build folders come back when you reinstall or rebuild the project. Emptying the Recycle Bin is permanent too.",
  },
  {
    q: "Does Roomy upload anything?",
    a: "No. Roomy works fully offline: no account, no telemetry, no analytics, no network calls at all.",
  },
  {
    q: "Why is my disk fuller than all my folders add up to?",
    a: "Part of it is big system files, like the page file and the hibernation file. Roomy finds those and lists them by name under System. The rest is space that no folder shows at all: restore points or local snapshots, storage reserved for updates, file-system bookkeeping and folders you don't have permission to open. Roomy shows that remainder as its own labeled \"Hidden\" block, so all of your used space is accounted for.",
  },
  {
    q: "How fast is a scan?",
    a: "It depends on your drive and how many files it holds. Roomy's native scanner reads folders on many threads in parallel, then shows you everything it found.",
  },
  {
    q: "How do I update?",
    a: `Version 0.1.0 doesn't update itself. Download the newest installer from this page or ${a(LINKS.releases, "GitHub Releases")} and install it over the old one.`,
  },
  {
    q: "Is there a Linux version?",
    a: `Not yet. Roomy runs on Windows 10 and 11 (x64) and macOS 10.15 or later. Follow the ${a(LINKS.github, "repository")} for news.`,
  },
];
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="section-head">
      <p class="kicker">FAQ</p>
      <h2 id="faq-title" class="title-1">Questions, answered.</h2>
      <p class="lead">Something else? <a class="prose-link" href={LINKS.issues}>Open an issue on GitHub</a>.</p>
    </div>
    <div class="list">
      {faqs.map((f) => (
        <details class="item">
          <summary>
            <span>{f.q}</span>
            <span class="plus" aria-hidden="true"><Icon name="plus" size={18} /></span>
          </summary>
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .section-head {
    position: sticky;
    top: 92px;
  }
  .list {
    border-top: 1px solid var(--line);
  }
  .item {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    display: grid;
    place-items: center;
    flex: none;
    color: var(--ink-2);
    transition: transform var(--dur-base) var(--ease);
  }
  .item[open] .plus {
    transform: rotate(45deg);
  }
  .item p {
    padding: 0 2.5rem 1.4rem 0;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
    }
    .section-head {
      position: static;
    }
    .item p {
      padding-right: 0;
    }
  }
</style>
