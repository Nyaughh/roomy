---
// "Nothing hidden": the whole drive as one bar, with the space most tools can't explain labeled.
// Same categories as the app's Storage screen (brand/tokens.json "storageCategories").
const parts = [
  { label: "Media", gb: 84, viz: "powder" },
  { label: "Apps", gb: 78, viz: "lilac" },
  { label: "Games", gb: 54, viz: "pistachio" },
  { label: "Projects", gb: 52, viz: "mist" },
  { label: "System", gb: 36, viz: "slate" },
  { label: "Hidden", gb: 14, viz: "stone", hatch: true },
  { label: "Downloads", gb: 32, viz: "peach" },
  { label: "Caches & temp", gb: 22, viz: "blush" },
  { label: "Documents", gb: 12, viz: "sand" },
  { label: "Other", gb: 6, viz: "stone" },
  { label: "Free", gb: 122, viz: "free" },
];
---

<section class="section accounted" aria-labelledby="acc-title">
  <div class="container">
    <div class="grid">
      <p class="big num" aria-hidden="true">100%</p>
      <div class="section-head">
        <p class="kicker">Nothing hidden</p>
        <h2 id="acc-title" class="title-1">Every gigabyte, accounted for.</h2>
        <p class="lead">
          Phones show storage by category, then leave a vague "System" or "Other" you can't open. Roomy counts each
          app's data and caches with the app, and labels the space your system keeps for itself, so every category adds
          up to the whole.
        </p>
      </div>
    </div>

    <figure class="drive">
      <div class="bar" role="img" aria-label="A 512 gigabyte drive: Media 84, Apps 78, Games 54, Projects 52, System 36, Hidden 14, Downloads 32, Caches and temp 22, Documents 12, Other 6, Free 122 gigabytes.">
        {parts.map((p) => (
          <span class:list={["seg", { hatch: p.hatch, free: p.viz === "free" }]} style={`flex:${p.gb};--fill:var(--viz-${p.viz})`}></span>
        ))}
      </div>
      <ul class="legend" aria-hidden="true">
        {parts.map((p) => (
          <li>
            <i class:list={[{ hatch: p.hatch, free: p.viz === "free" }]} style={`--fill:var(--viz-${p.viz})`}></i>
            <span class="l">{p.label}</span>
            <span class="v num">{p.gb} GB</span>
          </li>
        ))}
      </ul>
      <figcaption>A 512 GB drive, as Roomy shows it. The hatched block is real space that no folder shows.</figcaption>
    </figure>

    <div class="hidden-list">
      <h3 class="title-3">What's in "Hidden"?</h3>
      <div>
        <ul>
          <li>Restore points and local snapshots</li>
          <li>Storage the system reserves for updates</li>
          <li>File-system bookkeeping</li>
          <li>Folders you don't have permission to open</li>
        </ul>
        <p class="aside">
          Big system files you can see, like the page file and hibernation file, aren't part of this gap. Roomy lists
          them by name under System.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
  }
  .big {
    font-size: clamp(5rem, 16vw, 12.5rem);
    line-height: 0.82;
    letter-spacing: -0.06em;
    font-weight: 600;
    color: var(--ink);
  }

  .drive {
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
  }
  .bar {
    display: flex;
    gap: 3px;
    height: clamp(44px, 6vw, 64px);
  }
  .seg {
    min-width: 6px;
    border-radius: var(--radius-tile);
    background: var(--fill);
  }
  .hatch {
    background:
      repeating-linear-gradient(135deg, var(--viz-hatch) 0 2px, transparent 2px 7px),
      var(--fill);
  }
  .free {
    background: var(--sunken);
    box-shadow: 0 0 0 1px var(--line-strong) inset;
  }
  .legend {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .legend li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.5rem;
    align-items: center;
    font-size: 0.875rem;
  }
  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--fill);
  }
  .legend .l {
    font-weight: 560;
  }
  .legend .v {
    grid-column: 2;
    color: var(--ink-2);
  }
  figcaption {
    margin-top: 1.25rem;
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .hidden-list {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .hidden-list ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }
  .aside {
    margin-top: 1.25rem;
    color: var(--ink-3);
    font-size: 0.9rem;
  }
  .hidden-list li {
    padding-left: 1.1rem;
    position: relative;
  }
  .hidden-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--viz-stone);
    box-shadow: 0 0 0 1px var(--line-strong) inset;
  }

  @media (max-width: 900px) {
    .grid,
    .hidden-list {
      grid-template-columns: 1fr;
    }
    .legend {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hidden-list ul {
      grid-template-columns: 1fr;
    }
  }
</style>
