---
import Icon from "./Icon.astro";
import Glyph from "./Glyph.astro";
import MacInstallCommand from "./MacInstallCommand.astro";
import { LINKS, SITE } from "../site";
---

<section id="download" class="section download" aria-labelledby="download-title">
  <div class="container">
    <div class="head">
      <Glyph size={44} class="glyph" />
      <h2 id="download-title" class="title-1">Get Roomy.</h2>
      <p class="lead">Free. Version {SITE.version}, for Windows and Mac. No account, no sign-up.</p>
    </div>

    <div class="platforms" id="install">
      <article class="plat plat-win" aria-labelledby="win-title">
        <div class="plat-head">
          <Icon name="windows" size={28} />
          <div class="ph-text">
            <h3 id="win-title" class="title-2">Windows</h3>
            <p class="req">Windows 10 or 11 (x64)</p>
          </div>
          <span class="yours">Your system</span>
        </div>
        <a class="btn dl" href={LINKS.windowsExe}><Icon name="download" /> Download installer (.exe)</a>
        <p class="alt">Prefer MSI? <a class="prose-link" href={LINKS.windowsMsi}>Roomy-x64.msi</a></p>
        <ol class="install">
          <li>Run <code>Roomy-setup-x64.exe</code>. If WebView2 is missing, the installer adds it. Windows 11 already has it.</li>
          <li>
            Roomy isn't code-signed yet, so Windows may show <strong>"Windows protected your PC"</strong>. Choose{" "}
            <strong>More info</strong>, then <strong>Run anyway</strong>.
          </li>
          <li>Open Roomy from the Start menu and pick a drive to scan.</li>
        </ol>
      </article>

      <article class="plat plat-mac" aria-labelledby="mac-title">
        <div class="plat-head">
          <Icon name="apple" size={28} />
          <div class="ph-text">
            <h3 id="mac-title" class="title-2">Mac</h3>
            <p class="req">macOS 10.15 or later · Apple silicon and Intel</p>
          </div>
          <span class="yours">Your system</span>
        </div>
        <div class="terminal-install">
          <MacInstallCommand />
          <p class="alt">
            The installer quits Roomy if it’s running, copies the latest version to Applications and clears its download
            flag. <a class="prose-link" href="/install.sh">Read the script</a>.
          </p>
        </div>
        <p class="manual">
          Prefer Finder? <a class="prose-link" href={LINKS.macDmg}>Download the .dmg</a> and drag Roomy into Applications.
          If macOS blocks the first launch, choose <strong>Open Anyway</strong> in System Settings › Privacy &amp; Security.
        </p>
        <p class="alt">For the most complete scan, give Roomy <strong>Full Disk Access</strong> in Privacy &amp; Security.</p>
      </article>
    </div>

    <p class="foot-note">
      Why the warnings? Code-signing certificates cost money and Roomy is a free project. The source is{" "}
      <a class="prose-link" href={LINKS.github}>on GitHub</a> if you'd rather read it or build it yourself. Every version is on{" "}
      <a class="prose-link" href={LINKS.releases}>Releases</a>. Linux isn't supported yet.
    </p>
  </div>
</section>

<style>
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .head :global(.glyph) {
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
  .head .lead {
    margin-top: 1rem;
  }

  .platforms {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    margin-top: clamp(3rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
  }
  .plat {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(0rem, 3vw, 2.75rem) 0;
  }
  .plat-win {
    border-right: 1px solid var(--line);
    padding-left: 0;
  }
  .plat-mac {
    padding-right: 0;
  }
  :global([data-os="mac"]) .plat-mac {
    order: -1;
    border-right: 1px solid var(--line);
    padding-left: 0;
    padding-right: clamp(0rem, 3vw, 2.75rem);
  }
  :global([data-os="mac"]) .plat-win {
    border-right: 0;
    padding-left: clamp(0rem, 3vw, 2.75rem);
    padding-right: 0;
  }

  .plat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }
  .ph-text {
    min-width: 0;
    flex: 1 1 12rem;
  }
  .req {
    margin-top: 0.15rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .yours {
    display: none;
    padding: 0.15rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--butter-wash);
    color: var(--butter-deep);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }
  :global([data-os="win"]) .plat-win .yours,
  :global([data-os="mac"]) .plat-mac .yours {
    display: inline-block;
  }

  .dl {
    margin-top: 1.75rem;
    --h: 52px;
    white-space: normal;
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .dl:hover {
    border-color: var(--ink-2);
  }
  /* the detected platform (or both, when unknown) gets the butter button */
  :global([data-os="win"]) .plat-win .dl,
  :global([data-os="other"]) .dl {
    background: var(--butter);
    color: var(--butter-ink);
    border-color: transparent;
  }
  :global([data-os="win"]) .plat-win .dl:hover,
  :global([data-os="other"]) .dl:hover {
    background: var(--butter-hover);
  }
  .alt {
    margin-top: 0.75rem;
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  .install {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: i;
    display: grid;
    gap: 1rem;
  }
  .install li {
    position: relative;
    min-width: 0;
    padding-left: 2rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    counter-increment: i;
  }
  .install li::before {
    content: counter(i);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.4rem;
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .install strong {
    color: var(--ink);
    font-weight: 600;
  }
  .install code {
    padding: 0.05rem 0.35rem;
    border-radius: 6px;
    background: var(--sunken);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .terminal-install, .manual {
    margin-top: 1.75rem;
  }
  .manual {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .foot-note {
    max-width: 680px;
    margin: clamp(3rem, 6vw, 4rem) auto 0;
    color: var(--ink-2);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 820px) {
    .platforms {
      grid-template-columns: minmax(0, 1fr);
    }
    .plat,
    :global([data-os="mac"]) .plat-mac,
    :global([data-os="mac"]) .plat-win {
      padding: 2rem 0 2.25rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
