---
import ProductWindow from "./ProductWindow.astro";
import Icon from "./Icon.astro";
import { LINKS, SITE } from "../site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="copy">
      <p class="kicker">Roomy {SITE.version} · Free for Windows and Mac</p>
      <h1 id="hero-title" class="display">Make room.</h1>
      <p class="lead">
        Storage, like the screen on your phone, but it shows everything: every app with its data and caches, every
        project, every hidden gigabyte. Then clear what you don't need, with every step explained.
      </p>

      <div class="ctas">
        <!-- The visitor's OS (set in <head>) picks the primary button; the other platform stays one click away. -->
        <a class="btn btn-primary for-win" href={LINKS.windowsExe}><Icon name="download" /> Download for Windows</a>
        <a class="btn btn-primary for-mac" href={LINKS.macDmg}><Icon name="download" /> Download for Mac</a>
        <a class="btn btn-primary for-other" href="#download"><Icon name="download" /> Download</a>
        <a class="link-arrow alt" href="#download">
          <span class="for-win-t">Also for Mac</span><span class="for-mac-t">Also for Windows</span><span class="for-other-t">Windows and Mac</span>
          <Icon name="arrow-right" />
        </a>
      </div>
      <p class="req">
        <span class="for-win-t">Windows 10 or 11 (x64)</span>
        <span class="for-mac-t">macOS 10.15 or later, Apple silicon and Intel</span>
        <span class="for-other-t">Windows 10/11 (x64) · macOS 10.15 or later</span>
      </p>
    </div>
  </div>

  <div class="stage container">
    <ProductWindow />
  </div>

  <div class="container">
    <ul class="facts">
      <li><strong>Free and open source.</strong> No trial, no upsell, no account.</li>
      <li><strong>Fully offline.</strong> No telemetry. Your file list never leaves your computer.</li>
      <li><strong>Careful by design.</strong> Every clean-up is reviewed first and says how each item is removed.</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 9vw, 7rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .copy {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }
  .display {
    margin-top: 1rem;
  }
  .lead {
    max-width: 580px;
    margin: 1.5rem auto 0;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2.25rem;
  }
  .ctas .btn {
    --h: 52px;
    padding-inline: 1.6rem;
  }
  .req {
    margin-top: 1rem;
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  /* OS-specific visibility */
  .for-win,
  .for-mac,
  .for-win-t,
  .for-mac-t {
    display: none;
  }
  :global([data-os="win"]) .for-win,
  :global([data-os="mac"]) .for-mac {
    display: inline-flex;
  }
  :global([data-os="win"]) .for-win-t,
  :global([data-os="mac"]) .for-mac-t {
    display: inline;
  }
  :global([data-os="win"]) .for-other,
  :global([data-os="mac"]) .for-other,
  :global([data-os="win"]) .for-other-t,
  :global([data-os="mac"]) .for-other-t {
    display: none;
  }

  .stage {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    animation: rise 0.7s var(--ease) 0.05s both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-strong);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .facts strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
  @media (max-width: 480px) {
    .ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>
