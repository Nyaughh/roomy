---
import Logo from "./Logo.astro";
import { LINKS, SITE } from "../site";
---

<footer class="footer">
  <div class="container">
    <div class="closer">
      <p class="title-1">Make room.</p>
      <a class="btn btn-primary" href="#download">Download Roomy</a>
    </div>
    <div class="bottom">
      <div class="brand">
        <Logo height={22} />
        <p>A storage analyzer and cleaner that hides nothing.</p>
      </div>
      <nav aria-label="Footer">
        <ul>
          <li><a href={LINKS.github}>GitHub</a></li>
          <li><a href={LINKS.releases}>Releases</a></li>
          <li><a href={LINKS.issues}>Report an issue</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">Roomy {SITE.version} · Free · Source on GitHub · Works offline</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-bottom: 2.5rem;
  }
  .closer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .brand {
    color: var(--ink);
  }
  .brand p {
    margin-top: 0.75rem;
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9rem;
  }
  nav a:hover {
    color: var(--ink);
  }
  .fine {
    margin-top: 2rem;
    color: var(--ink-3);
    font-size: 0.82rem;
  }
</style>
