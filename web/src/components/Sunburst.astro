---
// Static sunburst illustration, generated at build time.
type Node = { gb: number; tone: string; children?: Node[] };

const data: Node[] = [
  {
    gb: 186,
    tone: "var(--t1)",
    children: [
      { gb: 64, tone: "var(--t1)" },
      { gb: 52, tone: "var(--t4)" },
      { gb: 38, tone: "var(--t3)" },
      { gb: 32, tone: "var(--t5)" },
    ],
  },
  {
    gb: 132,
    tone: "var(--t2)",
    children: [
      { gb: 78, tone: "var(--t2)" },
      { gb: 54, tone: "var(--t5)" },
    ],
  },
  { gb: 36, tone: "var(--t6)", children: [{ gb: 22, tone: "var(--t6)" }, { gb: 14, tone: "var(--t6)" }] },
  { gb: 22, tone: "var(--coral)" },
  { gb: 14, tone: "url(#sb-hatch)" },
];

const total = data.reduce((s, n) => s + n.gb, 0);
const C = 100;
const PAD = 0.012; // radians between slices

function arc(r0: number, r1: number, a0: number, a1: number) {
  const s = a0 + PAD / 2;
  const e = a1 - PAD / 2;
  const p = (r: number, a: number) => `${(C + r * Math.sin(a)).toFixed(2)} ${(C - r * Math.cos(a)).toFixed(2)}`;
  const large = e - s > Math.PI ? 1 : 0;
  return `M${p(r1, s)} A${r1} ${r1} 0 ${large} 1 ${p(r1, e)} L${p(r0, e)} A${r0} ${r0} 0 ${large} 0 ${p(r0, s)} Z`;
}

const slices: { d: string; fill: string; ring: number; i: number }[] = [];
let a = 0;
let i = 0;
for (const n of data) {
  const span = (n.gb / total) * Math.PI * 2;
  slices.push({ d: arc(40, 66, a, a + span), fill: n.tone, ring: 1, i: i++ });
  if (n.children) {
    let b = a;
    for (const c of n.children) {
      const cs = (c.gb / n.gb) * span;
      slices.push({ d: arc(70, 94, b, b + cs), fill: c.tone, ring: 2, i: i++ });
      b += cs;
    }
  }
  a += span;
}
---

<svg class="sunburst" viewBox="0 0 200 200" aria-hidden="true">
  <defs>
    <pattern id="sb-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="5" height="5" fill="var(--raised)"></rect>
      <rect width="2" height="5" fill="var(--muted)" opacity="0.45"></rect>
    </pattern>
  </defs>
  {slices.map((s) => <path d={s.d} fill={s.fill} class={`r${s.ring}`} style={`--i:${s.i}`} />)}
  <circle cx="100" cy="100" r="35" fill="var(--raised)"></circle>
  <text x="100" y="97" text-anchor="middle" class="big">390 GB</text>
  <text x="100" y="111" text-anchor="middle" class="small">used</text>
</svg>

<style>
  .sunburst {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  path {
    transform-origin: 100px 100px;
    transition:
      transform 0.35s var(--ease),
      filter 0.2s;
  }
  .r2 {
    opacity: 0.82;
  }
  path:hover {
    transform: scale(1.03);
    filter: brightness(1.1);
  }
  .big {
    fill: var(--text);
    font-size: 13px;
    font-weight: 650;
  }
  .small {
    fill: var(--muted);
    font-size: 9px;
  }
</style>
