---
// Roomy lockup (brand/logo.svg): three-cell glyph + Instrument Sans wordmark, as outlines.
// Ink parts use currentColor so the logo follows the site theme; the freed cell stays butter.
interface Props {
  height?: number;
  label?: string;
}
const { height = 26, label = "Roomy" } = Astro.props;
const VB = "-2 -120.32 765.36 163.32";
const [, , vw, vh] = VB.split(" ").map(Number);
const width = Math.round((height * vw) / vh);
