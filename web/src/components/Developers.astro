---
// Developer clutter Roomy recognizes, per platform, from the app's suggestion list
// (app/src-tauri/src/suggest.rs at 685cb69). "Ticked" = pre-selected, "Listed" = offered, "—" = not on that platform.
type State = "Ticked" | "Listed" | "Opt-in" | null;
const rows: { n: string; win: State; mac: State }[] = [
  { n: "npm cache", win: "Ticked", mac: "Ticked" },
  { n: "pnpm store", win: "Listed", mac: "Listed" },
  { n: "Bun cache", win: "Listed", mac: "Listed" },
  { n: "Cargo registry cache", win: "Listed", mac: "Listed" },
  { n: "Gradle caches", win: "Listed", mac: "Listed" },
  { n: "Maven local repository", win: "Listed", mac: "Listed" },
  { n: "NuGet packages folder", win: "Listed", mac: "Listed" },
  { n: "pnpm metadata cache", win: "Ticked", mac: null },
  { n: "Yarn cache", win: "Ticked", mac: null },
  { n: "pip cache", win: "Ticked", mac: null },
  { n: "uv cache", win: "Ticked", mac: null },
  { n: "NuGet HTTP cache", win: "Ticked", mac: null },
  { n: "Go build cache", win: "Ticked", mac: null },
  { n: "Composer cache", win: "Ticked", mac: null },
  { n: "Xcode DerivedData", win: null, mac: "Ticked" },
  { n: "iOS device support files", win: null, mac: "Listed" },
  { n: "Project build folders", win: "Opt-in", mac: "Opt-in" },
];
const cls = (st: State) => (st ? st.toLowerCase().replace("-", "") : "none");
---

<section class="section dev" aria-labelledby="dev-title">
  <div class="container cols">
    <div class="section-head">
      <p class="kicker">For developers</p>
      <h2 id="dev-title" class="title-1">The gigabytes your tools forget.</h2>
      <p class="lead">
        Package caches pile up quietly. Roomy knows where they live. Project build folders like node_modules, Rust
        target folders and virtual environments are listed per project with the date each project last changed, and you
        pick which ones go.
      </p>
    </div>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Developer caches and folders Roomy recognizes</caption>
        <thead>
          <tr><th scope="col">What</th><th scope="col">Windows</th><th scope="col">Mac</th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row"><code>{r.n}</code></th>
              <td>{r.win ? <span class:list={["st", cls(r.win)]}>{r.win}</span> : <span class="none" aria-hidden="true">—</span><span class="sr-only">Not on Windows</span>}</td>
              <td>{r.mac ? <span class:list={["st", cls(r.mac)]}>{r.mac}</span> : <span class="none" aria-hidden="true">—</span><span class="sr-only">Not on Mac</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="foot">Ticked items are pre-selected; your tools fetch or rebuild them when needed. Listed items wait for you to tick them.</p>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .table-wrap {
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 0.5rem 1.25rem 1.1rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.7rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-weight: 400;
  }
  thead th {
    color: var(--ink-3);
    font-size: 0.8rem;
    font-weight: 560;
  }
  tbody th code {
    font-size: 0.85rem;
    color: var(--ink);
  }
  td {
    color: var(--ink-2);
  }
  .st {
    display: inline-block;
    padding: 0.05rem 0.55rem;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 560;
    white-space: nowrap;
  }
  .ticked {
    background: var(--positive-wash);
    color: var(--positive);
  }
  .listed {
    background: var(--sunken);
    color: var(--ink-2);
  }
  .optin {
    background: var(--butter-wash);
    color: var(--butter-deep);
  }
  .none {
    color: var(--ink-3);
  }
  .foot {
    margin-top: 0.9rem;
    color: var(--ink-3);
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .table-wrap {
      padding-inline: 0.75rem;
    }
    th,
    td {
      padding-inline: 0.15rem;
    }
  }
</style>
