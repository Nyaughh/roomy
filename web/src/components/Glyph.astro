---
// The three-cell glyph (brand/glyph.svg). Ink cells use currentColor; the freed cell is butter.
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 288 288" aria-hidden="true">
  <rect x="0" y="0" width="130" height="288" rx="22" fill="currentColor"></rect>
  <rect x="158" y="0" width="130" height="130" rx="22" fill="currentColor"></rect>
  <rect x="158" y="158" width="130" height="130" rx="22" fill="var(--butter)"></rect>
</svg>
