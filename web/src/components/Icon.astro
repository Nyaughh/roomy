---
// Minimal inline line icons (24px grid, 1.75 stroke). Only what the page needs.
type Name = "download" | "github" | "windows" | "apple" | "sun" | "moon" | "check" | "copy" | "arrow-right" | "plus";

interface Props {
  name: Name;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
const filled = name === "github" || name === "windows" || name === "apple";
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? "currentColor" : "none"}
  stroke={filled ? "none" : "currentColor"}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "download" && <><path d="M12 4v11" /><path d="m7 10.5 5 5 5-5" /><path d="M5 20h14" /></>}
  {name === "github" && (
    <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
  )}
  {name === "windows" && <path d="M3 5.6 10.4 4.6v7H3V5.6Zm8.4-1.1L21 3.2v8.4h-9.6V4.5ZM3 12.6h7.4v7l-7.4-1v-6Zm8.4 0H21V21l-9.6-1.3v-7.1Z" />}
  {name === "apple" && (
    <path d="M16.37 12.58c-.02-2.24 1.83-3.32 1.91-3.37-1.04-1.52-2.66-1.73-3.24-1.75-1.38-.14-2.69.81-3.39.81-.7 0-1.78-.79-2.92-.77-1.5.02-2.89.87-3.66 2.21-1.56 2.71-.4 6.72 1.12 8.92.74 1.08 1.63 2.29 2.79 2.24 1.12-.04 1.54-.72 2.9-.72 1.35 0 1.73.72 2.92.7 1.2-.02 1.97-1.1 2.71-2.18.85-1.25 1.2-2.46 1.22-2.52-.03-.01-2.34-.9-2.36-3.57ZM14.15 5.98c.62-.75 1.03-1.78.92-2.82-.89.04-1.97.59-2.6 1.34-.57.66-1.07 1.72-.94 2.73.99.08 2-.5 2.62-1.25Z" />
  )}
  {name === "sun" && <><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></>}
  {name === "moon" && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === "copy" && <><rect x="8.5" y="8.5" width="11" height="11" rx="2.5" /><path d="M15.5 8.5V7a2.5 2.5 0 0 0-2.5-2.5H7A2.5 2.5 0 0 0 4.5 7v6A2.5 2.5 0 0 0 7 15.5h1.5" /></>}
  {name === "arrow-right" && <><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></>}
  {name === "plus" && <><path d="M12 5v14" /><path d="M5 12h14" /></>}
