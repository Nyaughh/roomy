---
import "@fontsource-variable/instrument-sans/standard.css";
import fontLatin from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-standard-normal.woff2?url";
import "../styles/global.css";
import { SITE } from "../site";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${SITE.name}: make room on your disk`, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL("/og.png", SITE.url).href;
---

<!doctype html>
<html lang="en" data-theme="light" data-os="other">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F4F2EC" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Roomy: Make room. The Roomy Storage screen: 368 GB used of 512 GB, a stacked usage bar and categories like Media, Apps and Projects, with Caches and temp showing 22 GB made room." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: SITE.name,
      description: SITE.description,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Windows, macOS",
      softwareVersion: SITE.version,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      url: SITE.url,
      downloadUrl: `${SITE.repo}/releases/latest`,
    })} />

    <!-- Theme + OS detection run before first paint to avoid flashes. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem("roomy-theme");
          if (t === "light" || t === "dark") d.dataset.theme = t;
          else if (window.matchMedia("(prefers-color-scheme: dark)").matches) d.dataset.theme = "dark";
        } catch (e) {}
        if (d.dataset.theme === "dark") document.querySelector('meta[name="theme-color"]').setAttribute("content", "#131210");
        var p = "";
        try {
          p = ((navigator.userAgentData && navigator.userAgentData.platform) || "") + " " + navigator.userAgent;
        } catch (e) {}
        var mobile = /iPhone|iPad|iPod|Android/i.test(p) || (/Mac/.test(p) && navigator.maxTouchPoints > 1);
        d.dataset.os = mobile ? "other" : /Win/i.test(p) ? "win" : /Mac/i.test(p) ? "mac" : "other";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
